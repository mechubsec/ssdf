#!/usr/sbin/nft -f

# SSDF ingest hardening (security review 2026-06-10, finding H1).
# Restrict UDP 514 (SRX) / 515 (PAN-OS) / 516 (UniFi) / 517 (Proxmox host) / 518 (Junos SYSTEM)
# to the vSRX test fleet + panosvm + UniFi controller + pve3 host.
# Host-log ports (TCP 6000 Vector agents, TCP/UDP 519 generic syslog) follow the
# same pattern. The addresses below are placeholders: the real sender
# allow-lists are deployment-specific and kept by the operator.
# Dedicated table; does not touch the default `inet filter` table.
# The `table ... / delete table ...` prologue makes reloads idempotent.

table inet ssdf_ingest
delete table inet ssdf_ingest
table inet ssdf_ingest {
    chain input {
        type filter hook input priority filter; policy accept;

        # Allowed syslog senders: full vSRX fleet + panosvm (198.51.100.219-.245).
        udp dport { 514, 515 } ip saddr 198.51.100.219-198.51.100.245 accept

        # vSRX test-fleet DATA-PLANE source range (added 2026-06-26). Stream-mode
        # security logs egress from ge-0/0/0 (198.51.100.150-.175), NOT fxp0, so the
        # full fleet (not just devices renumbered into .220-.242) reaches Vector.
        # .171-.175 cover the 5 isolated devices given a new vmbr0 data-plane vNIC.
        udp dport { 514, 515 } ip saddr 198.51.100.150-198.51.100.175 accept

        # UniFi (M9): CEF "Threat Detected" IPS events on UDP 516. The UniFi
        # SIEM export is forwarded by the Cloud Key controller (198.51.100.30),
        # NOT the Gateway Max itself (198.51.100.1, which only emits plain
        # RFC3164 system-log noise that the unifi_cef_threat filter drops).
        udp dport 516 ip saddr 198.51.100.30 accept

        # Proxmox (M11): rsyslog from the pve3 hypervisor host on UDP 517
        # (pvedaemon/pveproxy/sshd auth + admin-action audit stream).
        udp dport 517 ip saddr 198.51.100.201 accept

        # Junos SYSTEM syslog (M14c P3): vSRX fleet SSH auth + config commits on UDP 518.
        # Same source ranges as the security logs (514/515): full fleet + data-plane.
        udp dport 518 ip saddr 198.51.100.219-198.51.100.245 accept
        udp dport 518 ip saddr 198.51.100.150-198.51.100.175 accept

        # Host logs: a second Proxmox node on UDP 517 (same stream as above).
        udp dport 517 ip saddr 198.51.100.202 accept

        # Host logs: Vector agents on Linux hosts ship journald events on TCP 6000.
        tcp dport 6000 ip saddr 203.0.113.0/28 accept

        # Host logs: generic syslog senders (rsyslog, appliances) on TCP and UDP 519.
        tcp dport 519 ip saddr 192.0.2.0/28 accept
        udp dport 519 ip saddr 192.0.2.0/28 accept

        # Everything else hitting the ingest ports is dropped.
        udp dport { 514, 515, 516, 517, 518, 519 } drop
        tcp dport { 519, 6000 } drop
    }
}
