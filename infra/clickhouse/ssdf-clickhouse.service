[Unit]
Description=SSDF ClickHouse Database
After=network-online.target
Wants=network-online.target
Documentation=https://clickhouse.com/docs

[Service]
Type=simple
User=clickhouse
Group=clickhouse
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CacheDirectory=clickhouse
LogsDirectory=clickhouse
ConfigurationDirectory=clickhouse
RuntimeDirectory=clickhouse
RuntimeDirectoryMode=0750
Environment=CLICKHOUSE_CONFIG=/etc/clickhouse-server/config.xml

# Listen address is config.xml-controlled, not an env var clickhouse-server
# reads (CLICKHOUSE_HOST has no effect here). Default posture is
# localhost-only for plain HTTP/native, matching ct104's hardening
# (infra/clickhouse/config.d/ssdf-tls.xml): wide binds are closed off by the
# host firewall, not opened by this unit. Edit config.xml's <listen_host> if
# a deployment genuinely needs a non-default bind.

# HTTP port (default: 8123)
Environment=CLICKHOUSE_HTTP_PORT=8123

# Native protocol port (default: 9000)
Environment=CLICKHOUSE_TCP_PORT=9000

# Start command
ExecStart=/usr/bin/clickhouse-server --config-file=/etc/clickhouse-server/config.xml

# Restart policy
Restart=on-failure
RestartSec=3

# Resource limits. Core dumps are disabled: a crash dump of a process
# holding security logs and plaintext credentials is its own leak path.
LimitCORE=0
LimitNOFILE=262144

# Directory permissions
ReadWritePaths=/var/lib/clickhouse /var/log/clickhouse-server

[Install]
WantedBy=multi-user.target
