[Unit]
Description=SSDF Single-Host Profile (ClickHouse + MCP Query)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
Environment=CH_HOST=127.0.0.1
Environment=CH_PORT=8123
Environment=CH_USER=default
EnvironmentFile=/etc/ssdf/single-host.env

# Start: initialize DB and start services
ExecStart=/bin/bash -c ' \
    echo "Starting ClickHouse..." && \
    systemctl start ssdf-clickhouse && \
    echo "Waiting for ClickHouse to be ready..." && \
    until clickhouse-client --query "SELECT 1" &>/dev/null; do sleep 1; done && \
    echo "Applying migrations..." && \
    CH_HOST=127.0.0.1 CH_PORT=8123 CH_USER=default CH_PASSWORD="" python3 /opt/ssdf/scripts/run_migrations.py && \
    echo "Starting MCP Query service..." && \
    systemctl start ssdf-mcp-query'

# Stop: stop services in reverse order
ExecStop=/bin/bash -c ' \
    echo "Stopping MCP Query service..." && \
    systemctl stop ssdf-mcp-query && \
    echo "Stopping ClickHouse..." && \
    systemctl stop ssdf-clickhouse'

# Status: check both services
ExecStatus=/bin/bash -c ' \
    echo "ClickHouse status:" && \
    systemctl is-active ssdf-clickhouse && \
    echo "MCP Query status:" && \
    systemctl is-active ssdf-mcp-query'

[Install]
WantedBy=multi-user.target
